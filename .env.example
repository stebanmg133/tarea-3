# Copia este archivo como .env y ajusta los valores.
# El archivo .env lo usa docker compose; para la app exporta las variables
# con:  set -a; . ./.env; set +a

# --- Oracle ---
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=UCO
ORACLE_PASSWORD=UCO
ORACLE_SYS_PASSWORD=oracle

